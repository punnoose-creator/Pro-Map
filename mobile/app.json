{
  "expo": {
    "name": "Field IQ",
    "slug": "field-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.promap.fieldiq",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131313"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA4vkdkaXlUJiaWVCuTlmgjkFvDi_bxMYM"
        }
      },
      "package": "com.promap.fieldiq",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Field IQ to use your location even when the app is in the background to ensure accurate work tracking.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow Field IQ to access the microphone for voice-to-text field logs.",
          "speechRecognitionPermission": "Allow Field IQ to use speech recognition for transcribing your field visit notes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "gradleProperties": {
              "android.enableJetifier": "true",
              "android.useAndroidX": "true"
            },
            "packagingOptions": {
              "pickFirsts": [
                "META-INF/androidx.appcompat_appcompat.version",
                "META-INF/androidx.core_core.version",
                "META-INF/androidx.loader_loader.version",
                "META-INF/androidx.versionedparcelable_versionedparcelable.version",
                "META-INF/androidx.vectordrawable_vectordrawable.version",
                "META-INF/androidx.vectordrawable_animated-vector-drawable.version"
              ]
            }
          }
        }
      ],
      "./plugins/withAndroidXFix"
    ],
    "extra": {
      "eas": {
        "projectId": "c8f27a49-e916-4cda-9b38-2f21632df37f"
      }
    }
  }
}
